{
  "name": "tokio-queue",
  "version": "0.1.0",
  "description": "Queue prompts for your LLM coding agents and watch your subscription quota. Jobs run themselves when your limit resets.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "bin": {
    "tokio": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "build:web": "vite build",
    "dev": "node --no-warnings --experimental-strip-types src/cli.ts start --dev",
    "dev:web": "vite",
    "test": "node --no-warnings --experimental-strip-types --test test/*.test.ts",
    "start": "node dist/cli.js start",
    "prepare": "npm run build",
    "app": "npm run build && cd desktop && npm start"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "chokidar": "^4.0.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  },
  "keywords": [
    "claude-code",
    "llm",
    "token-usage",
    "queue",
    "dashboard",
    "cli",
    "anthropic",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariomontecatine/tokio.git"
  },
  "bugs": {
    "url": "https://github.com/mariomontecatine/tokio/issues"
  },
  "homepage": "https://github.com/mariomontecatine/tokio#readme"
}
